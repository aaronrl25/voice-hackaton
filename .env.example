# Browser configuration. Everything with a VITE_ prefix is compiled into the public
# JavaScript bundle and is readable by anyone who opens devtools. Never put a secret here.
VITE_CONVEX_URL=
VITE_VOICEOS_AGENT_ID=

# ── Anthropic key ────────────────────────────────────────────────────────────
# Paste it into .env.local (NOT here — this file is committed) as:
#
#   ANTHROPIC_API_KEY=sk-ant-...
#
# then run:  npm run key
#
# That stores it on the Convex backend, where convex/anthropic.ts reads it. Running
# `npm run key` with nothing pasted prompts for it instead, with the input masked.
#
# The plain name matters: Vite only exposes VITE_-prefixed variables to the browser,
# so ANTHROPIC_API_KEY in .env.local never reaches the bundle. .env.* is gitignored.
# With no key set, the app falls back to the local heuristic and keeps working.

# ── Outbound calling (Wolfie calls a trusted contact) ────────────────────────
# The number used when the app does not pass one:
CALL_PHONE_NUMBER=

# Two ways to place the call. Both are read by the dev-server endpoint in
# vite.config.ts, and neither belongs in a VITE_ variable.
#
# 1. The Zero CLI, if it is installed and signed in on this machine. Found via
#    ZERO_RUNNER, then ~/.zero/runtime/bin/zero, then PATH. Nothing to set.
#
# 2. Direct HTTP, which needs no local binary — put these in .env.local:
#      CALL_API_KEY=...        provider API key
#      CALL_API_URL=...        optional, defaults to https://api.bland.ai/v1/calls
#
# With neither configured the endpoint returns 501 and the app falls back to
# showing the number so the person can dial it themselves.
