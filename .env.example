# Browser configuration. Everything with a VITE_ prefix is compiled into the public
# JavaScript bundle and is readable by anyone who opens devtools. Never put a secret here.
VITE_CONVEX_URL=
VITE_VOICEOS_AGENT_ID=

# Secrets live on the Convex backend, not in this file and not in the repo.
# Set them on the deployment:
#
#   npx convex env set ANTHROPIC_API_KEY sk-ant-...
#   npx convex env list
#
# convex/anthropic.ts reads process.env.ANTHROPIC_API_KEY there. With no key set,
# the app falls back to the local heuristic and keeps working.
